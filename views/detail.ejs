<%- include('partials/head') %>
<div class="read-progress" aria-hidden="true"><i id="read-bar"></i></div>
<%- include('partials/nav') %>

<main class="read-wrap" id="reader" data-size="1">
    <nav class="crumbs" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span>›</span>
        <% const catItem = menu.find(m => work.category && work.category.toLowerCase().indexOf(m.name.replace('Truyện ', '').toLowerCase()) !== -1); %>
        <% if (catItem) { %><a href="<%= catItem.href %>"><%= catItem.name %></a><span>›</span><% } %>
        <span><%= work.title %></span>
    </nav>

    <article>
        <header class="read-head">
            <% if (work.category) { %><span class="chip chip-brand"><%= work.category %></span><% } %>
            <h1 class="read-title"><%= work.title %></h1>
            <div class="read-meta">
                <span><%- ico('user') %><%= work.author %></span>
                <span><%- ico('clock') %><%= readMin %> phút đọc</span>
                <span><%- ico('eye') %><%= work.views %> lượt xem</span>
            </div>
        </header>

        <% if (work.thumbnail) { %>
            <div class="read-hero"><img src="<%= work.thumbnail %>" alt="<%= work.title %>" data-fallback></div>
        <% } %>
        <div class="orn" aria-hidden="true"><%- ico('spark') %></div>

        <div class="work-content dropcap"><%- contentHtml %></div>

        <div class="read-end">
            <% if (work.tags && work.tags.length > 0) { %>
                <div class="tags"><% work.tags.forEach(tag => { %><span class="tag">#<%= tag %></span><% }) %></div>
            <% } %>
            <% if (source) { %>
                <p class="source-note">Nguồn tham khảo: <a href="<%= source.url %>" target="_blank" rel="nofollow noopener noreferrer"><%= source.host %></a>. Nội dung đã được biên tập lại bằng AI.</p>
            <% } %>
        </div>
    </article>

    <% if (related.length) { %>
    <section class="sec">
        <div class="sec-head"><h2>Cùng chuyên mục</h2></div>
        <div class="grid-cards">
            <% related.forEach(work => { %><%- include('partials/card', { work }) %><% }) %>
        </div>
    </section>
    <% } %>
</main>

<%- include('partials/dock', { showNav: false, prevUrl: null, nextUrl: null, toc: catItem ? catItem.href : '/' }) %>
<%- include('partials/footer') %>
