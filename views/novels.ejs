<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="page-head">
    <div class="page-head-in">
        <div class="badge">📖</div>
        <div><h1>Truyện dài</h1><p>Những bộ truyện nhiều chương, cập nhật thường xuyên.</p></div>
    </div>
</section>

<main class="wrap sec">
    <div class="grid-cards">
        <% novels.forEach(n => { %>
            <a href="/sach/<%= n.slug %>" class="story-card">
                <div class="media">
                    <% if (n.thumbnail) { %><img src="<%= n.thumbnail %>" alt="<%= n.title %>" loading="lazy" data-fallback>
                    <% } else { %><div class="cover <%= cover(n.slug) %>"><span class="serif"><%= initial(n.title) %></span></div><% } %>
                    <span class="chip"><%= n.totalChapters %> chương</span>
                </div>
                <div class="body">
                    <h3><%= n.title %></h3>
                    <p><%= n.synopsis %></p>
                    <div class="foot"><span><%= n.author %></span><b>Đọc ➔</b></div>
                </div>
            </a>
        <% }) %>
        <% if (novels.length === 0) { %><div class="empty-state"><%- ico('book') %><p>Chưa có truyện dài nào được đăng.</p></div><% } %>
    </div>
</main>

<%- include('partials/footer') %>
