<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="pub-hero">
    <div class="hero-art" aria-hidden="true"><i class="cover cover-0"><span class="serif">V</span></i><i class="cover cover-4"><span class="serif">H</span></i><i class="cover cover-6"><span class="serif">✦</span></i></div>
    <div class="pub-hero-in">
        <span class="eyebrow">Tinh hoa chữ Việt</span>
        <h1>Thế giới cổ tích trong tầm tay bạn</h1>
        <p>Khám phá kho tàng truyện dân gian Việt Nam và thế giới, cùng những bộ truyện dài mới — được biên tập bằng trí tuệ nhân tạo.</p>
        <form class="hero-search" action="/tim-kiem" method="get" role="search">
            <input type="search" name="q" maxlength="100" required placeholder="Tìm Tấm Cám, Thạch Sanh..." aria-label="Tìm kiếm truyện">
            <button>Tìm</button>
        </form>
    </div>
</section>

<main class="wrap">
    <% if (latestNovels && latestNovels.length) { %>
    <section class="sec">
        <div class="sec-head"><h2>Truyện dài mới</h2><a href="/sach">Xem tất cả ➔</a></div>
        <div class="shelf">
            <% latestNovels.forEach(n => { %>
                <a href="/sach/<%= n.slug %>" class="book">
                    <div class="cover <%= cover(n.slug) %>"><span class="serif"><%= initial(n.title) %></span></div>
                    <h3><%= n.title %></h3>
                    <small><%= n.totalChapters %> chương</small>
                </a>
            <% }) %>
        </div>
    </section>
    <% } %>

    <section class="sec">
        <div class="sec-head"><h2>Mới cập nhật</h2></div>
        <div class="grid-cards">
            <% latestWorks.forEach(work => { %><%- include('partials/card', { work }) %><% }) %>
            <% if (latestWorks.length === 0) { %>
                <div class="empty-state"><%- ico('book') %><p>Robot đang nạp truyện, bạn quay lại sau nhé.</p></div>
            <% } %>
        </div>
    </section>

    <section class="sec">
        <div class="sec-head"><h2>Chuyên mục</h2></div>
        <div class="tiles">
            <% menu.forEach(item => { %>
                <a href="<%= item.href %>" class="tile"><i><%= item.icon %></i><%= item.name %></a>
            <% }) %>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
