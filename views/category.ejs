<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Văn Hay</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #fbfaf8; }
        .font-serif { font-family: 'Playfair Display', serif; }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    </style>
</head>
<body class="text-stone-900">
    <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 no-underline">
                <div class="w-12 h-12 bg-[#431407] rounded-full flex items-center justify-center text-white font-serif text-2xl shadow-md">V</div>
                <h1 class="text-2xl font-bold font-serif tracking-tight text-stone-900">Văn Hay</h1>
            </a>
            
            <div class="hidden lg:flex items-center gap-6">
                <% menu.forEach(item => { %>
                    <a href="<%= item.href %>" class="text-stone-600 hover:text-amber-900 font-bold text-xs uppercase tracking-wider transition-colors no-underline"><%= item.name %></a>
                <% }) %>
            </div>

            <div class="flex items-center bg-stone-100 px-4 py-2 rounded-full border border-stone-200">
                <span class="mr-2 opacity-50">🔍</span>
                <input type="text" placeholder="Tìm kiếm..." class="bg-transparent border-none text-sm outline-none w-32 md:w-48">
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-4 gap-12">
        <!-- Sidebar -->
        <aside class="hidden lg:block space-y-2">
            <h2 class="text-xs font-black text-stone-400 uppercase tracking-[0.2em] mb-6">Chuyên mục</h2>
            <% menu.forEach(item => { %>
                <a href="<%= item.href %>" class="flex items-center gap-3 p-4 rounded-2xl hover:bg-amber-50 hover:text-amber-900 font-bold transition-all text-stone-600 no-underline">
                    <span class="text-xl opacity-70"><%= item.icon %></span>
                    <%= item.name %>
                </a>
            <% }) %>
        </aside>

        <!-- Category Content -->
        <div class="lg:col-span-3">
            <header class="mb-12">
                <h1 class="text-4xl font-serif font-bold text-stone-900 mb-2"><%= title %></h1>
                <p class="text-stone-500">Khám phá tinh hoa văn chương trong chuyên mục <%= title %></p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
                <% if (works && works.length > 0) { %>
                    <% works.forEach(work => { %>
                        <a href="/<%= work.slug %>" class="group bg-white rounded-3xl border border-stone-200 overflow-hidden hover:shadow-2xl transition-all no-underline flex flex-col">
                            <div class="aspect-[4/3] w-full overflow-hidden bg-stone-100 relative">
                                <% if (work.thumbnail) { %>
                                    <img src="<%= work.thumbnail %>" alt="<%= work.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-stone-300 text-6xl font-serif">V</div>
                                <% } %>
                            </div>
                            <div class="p-6 flex-1 flex flex-col">
                                <h3 class="text-xl font-serif font-bold mb-3 text-stone-800 line-clamp-2 group-hover:text-amber-900 transition-colors leading-snug"><%= work.title %></h3>
                                <p class="text-stone-400 text-xs mb-6 flex-1 line-clamp-3"><%= work.excerpt %></p>
                                <div class="flex items-center justify-between mt-auto pt-4 border-t border-stone-50">
                                    <span class="text-[10px] font-bold text-stone-400">— <%= work.author %></span>
                                    <span class="text-amber-900 font-black text-xs">Đọc ➔</span>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full text-center py-20 bg-white rounded-[3rem] border border-dashed border-stone-200">
                        <p class="text-stone-500">Robot đang nạp dữ liệu cho chuyên mục này...</p>
                        <div class="mt-10 animate-bounce text-6xl">🤖</div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="bg-stone-900 text-stone-500 py-20 mt-20 text-center">
        <h2 class="text-2xl font-serif font-bold text-white mb-4 uppercase tracking-widest">Văn Hay</h2>
        <p>© 2026 Văn Hay. All rights reserved.</p>
    </footer>
</body>
</html>
