<%- include('partials/head') %>
<%- include('partials/nav') %>

<% const item = menu.find(m => m.name === title); const isSearch = typeof query === 'string'; %>
<section class="page-head">
    <div class="page-head-in">
        <div class="badge"><%= isSearch ? '🔎' : (item ? item.icon : '📚') %></div>
        <div>
            <h1><%= title %></h1>
            <p><%= typeof subtitle === 'string' ? subtitle : 'Khám phá tinh hoa văn chương trong chuyên mục ' + title %></p>
            <% if (isSearch) { %>
                <form class="big-search" action="/tim-kiem" method="get" role="search">
                    <input type="search" name="q" maxlength="100" value="<%= query %>" placeholder="Nhập tên truyện hoặc từ khoá..." aria-label="Tìm kiếm truyện">
                    <button>Tìm</button>
                </form>
            <% } %>
        </div>
    </div>
</section>

<main class="wrap sec">
    <div class="grid-cards">
        <% works.forEach(work => { %><%- include('partials/card', { work }) %><% }) %>
        <% if (!works || works.length === 0) { %>
            <div class="empty-state"><%- ico('book') %><p><%= typeof emptyMessage === 'string' ? emptyMessage : 'Robot đang nạp dữ liệu cho chuyên mục này...' %></p></div>
        <% } %>
    </div>

    <% if (pagination && pagination.totalPages > 1) { %>
        <nav class="pager" aria-label="Phân trang">
            <% if (pagination.page > 1) { %><a href="<%= pagination.url(pagination.page - 1) %>" rel="prev">← Trước</a><% } %>
            <span>Trang <%= pagination.page %> / <%= pagination.totalPages %></span>
            <% if (pagination.page < pagination.totalPages) { %><a href="<%= pagination.url(pagination.page + 1) %>" rel="next">Sau →</a><% } %>
        </nav>
    <% } %>
</main>

<%- include('partials/footer') %>
