<%- include('_top', { pageTitle: novel.title }) %>
<%
  const pubCount = chapters.filter(c => c.status === 'published').length;
  const words = chapters.reduce((s, c) => s + (c.wordCount || 0), 0);
%>
<header class="adm-bar">
    <a href="/admin" class="icon-btn" aria-label="Quay lại"><%- ico('back') %></a>
    <h1>Quản lý truyện</h1>
    <button type="button" class="icon-btn" data-open="sheet-edit" aria-label="Chỉnh thông tin"><%- ico('edit') %></button>
</header>

<main class="adm-wrap">
    <section class="novel-hero">
        <div class="cover cover-lg <%= cover(novel.slug) %>"><span class="serif"><%= initial(novel.title) %></span></div>
        <div class="min-w-0">
            <span class="chip chip-dot <%= novel.status === 'published' ? 'chip-ok' : 'chip-draft' %>"><%= novel.status === 'published' ? 'Đã đăng' : 'Nháp' %></span>
            <h2 class="mt-2"><%= novel.title %></h2>
            <p><%= novel.synopsis || 'Chưa có giới thiệu.' %></p>
        </div>
    </section>

    <section class="stats stats-3">
        <div class="stat"><b><%= chapters.length %></b><span>Chương</span></div>
        <div class="stat"><b><%= pubCount %></b><span>Đã đăng</span></div>
        <div class="stat"><b><%= words >= 1000 ? (words / 1000).toFixed(1) + 'k' : words %></b><span>Từ</span></div>
    </section>

    <div class="actions">
        <% if (novel.status === 'published') { %>
            <a class="btn btn-block" href="/sach/<%= novel.slug %>"><%- ico('eye') %> Xem công khai</a>
            <button class="btn btn-block" type="button" data-action="set-status" data-slug="<%= novel.slug %>" data-status="draft">Gỡ xuống</button>
        <% } else { %>
            <button class="btn btn-primary btn-block" type="button" data-action="set-status" data-slug="<%= novel.slug %>" data-status="published"><%- ico('send') %> Đăng truyện</button>
        <% } %>
    </div>

    <div class="sec-title"><h3>Danh sách chương</h3></div>
    <p class="hint">Chương chỉ hiện công khai khi cả truyện và chương đều đã đăng.</p>
    <% if (chapters.length === 0) { %>
        <div class="card empty"><%- ico('edit') %><p><b>Chưa có chương nào</b></p><p>Bấm + để viết chương đầu tiên.</p></div>
    <% } else { %>
        <div class="card card-clip">
            <% chapters.forEach(ch => { %>
                <a class="row" href="/admin/novels/<%= novel.slug %>/chapters/<%= ch.no %>">
                    <span class="no"><%= ch.no %></span>
                    <span class="t"><b><%= ch.title || ('Chương ' + ch.no) %></b><small><%= ch.wordCount %> từ<%= ch.editedAt ? ' · đã chỉnh tay' : '' %></small></span>
                    <span class="chip <%= ch.status === 'published' ? 'chip-ok' : 'chip-draft' %>"><%= ch.status === 'published' ? 'Đã đăng' : 'Nháp' %></span>
                    <%- ico('chev') %>
                </a>
            <% }) %>
        </div>
    <% } %>
</main>

<nav class="tabbar" aria-label="Điều hướng">
    <a class="tab" href="/admin"><%- ico('book') %>Truyện</a>
    <button class="fab" type="button" data-action="add-chapter" data-slug="<%= novel.slug %>" aria-label="Thêm chương"><%- ico('plus') %></button>
    <a class="tab" href="/"><%- ico('globe') %>Website</a>
</nav>

<div class="backdrop" data-close></div>
<form class="sheet" id="sheet-edit" data-form="update-novel" data-slug="<%= novel.slug %>">
    <h3>Thông tin truyện</h3>
    <label class="label" for="et">Tên truyện</label>
    <input id="et" class="field" name="title" required maxlength="200" value="<%= novel.title %>">
    <label class="label" for="ea">Tác giả</label>
    <input id="ea" class="field" name="author" maxlength="100" value="<%= novel.author %>">
    <label class="label" for="es">Giới thiệu</label>
    <textarea id="es" class="field" name="synopsis" rows="5" maxlength="5000"><%= novel.synopsis %></textarea>
    <input type="hidden" name="status" value="<%= novel.status %>">
    <button class="btn btn-primary btn-block mt-form"><%- ico('save') %> Lưu thông tin</button>
    <p data-msg class="label msg"></p>
</form>
<%- include('_bottom') %>
