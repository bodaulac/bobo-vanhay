{
  "name": "bobo-vanhoc-v2",
  "version": "1.0.0",
  "description": "Bobo Văn Học - Phiên bản ổn định",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --minify",
    "dev:css": "tailwindcss -c tailwind.config.js -i src/styles/input.css -o public/css/app.css --watch",
    "build:editor": "esbuild src/admin/editor.jsx --bundle --minify --format=iife --target=es2020 --loader:.css=empty --define:process.env.NODE_ENV=\\\"production\\\" --outfile=public/assets/editor.js",
    "build": "npm run build:css && npm run build:editor"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "b2-cloud-storage": "^1.0.5",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "marked": "^18.1.3",
    "mongoose": "^8.1.3",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "novel": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19"
  }
}
